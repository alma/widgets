{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    // Tests and tooling run in Node and recent Chromium.
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src",
    "scripts",
    "tests",
    ".storybook/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
