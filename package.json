{
  "name": "@alma/widgets",
  "version": "3.1.1",
  "description": "Widgets to easily display information from Alma - https://getalma.eu",
  "keywords": [],
  "main": "dist/widgets.js",
  "umd:main": "dist/widgets.umd.js",
  "module": "dist/widgets.m.js",
  "typings": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "author": "Olivier Lance <olivier.lance@getalma.eu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alma/widgets.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=6.0.0"
  },
  "scripts": {
    "start": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "build:contract": "BUILD_VERSION=contract-test vite build",
    "check:es2021": "es-check es2021 dist/widgets.umd.js --checkFeatures && es-check es2021 dist/widgets.js --module --checkFeatures",
    "test": "vitest run --project unit --project browser --coverage",
    "test:no-coverage": "vitest run --project unit --project browser",
    "build:ref": "node scripts/build-ref.mjs",
    "test:contract:ref": "WIDGETS_DIST=dist-ref vitest run --project contract",
    "test:contract": "WIDGETS_DIST=dist vitest run --project contract",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:install": "playwright install --only-shell chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts ./src/ ./tests/ && stylelint 'src/**/*.css'",
    "lint:fix": "eslint --fix --ext .ts ./src/ ./tests/ && stylelint 'src/**/*.css' --fix",
    "test:harness": "node scripts/test-harness.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "translations:extract": "echo 'translations:extract is disabled until the Lit message descriptors exist, because it would empty src/intl/messages.json.' >&2 && exit 1",
    "translations:upload": "crowdin upload sources",
    "translations:download": "crowdin download && prettier ./src/intl --write",
    "prepare": "husky",
    "fixtures:messages": "node scripts/generate-message-fixture.mjs",
    "lint:package": "publint; attw --pack .; exit 0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@crowdin/cli": "^4.3.0",
    "@formatjs/cli": "^6.3.5",
    "@formatjs/icu-messageformat-parser": "2.9.4",
    "@formatjs/intl": "2.10.15",
    "@octokit/core": "^6.1.2",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/web-components-vite": "^10.6.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/clean-css": "^4.2.11",
    "@types/no-scroll": "^2.1.2",
    "@types/node": "^22.8.4",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "clean-css": "^5.3.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "es-check": "^9.8.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^4.1.4",
    "eslint-plugin-prettier": "^5.2.1",
    "expect-type": "^1.1.0",
    "husky": "^9.1.6",
    "jsdom": "^30.1.2",
    "lint-staged": "^15.2.10",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.64.1",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "publint": "^0.3.25",
    "storybook": "^10.6.3",
    "stylelint": "^13.13.1",
    "stylelint-a11y": "^1.2.3",
    "stylelint-config-standard": "^22.0.0",
    "ts-essentials": "^10.0.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@lit/task": "^1.0.3",
    "lit": "^3.3.3",
    "no-scroll": "^2.1.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "src/{*.ts,!(__lint-fixtures__)/**/*.ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/{*.css,!(__lint-fixtures__)/**/*.css}": [
      "stylelint --fix"
    ],
    "{tests,scripts}/**/*.{ts,mjs}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "publishConfig": {
    "access": "public"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
