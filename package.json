{
  "name": "@alma/widgets",
  "version": "3.1.1",
  "description": "Widgets to easily display information from Alma - https://getalma.eu",
  "keywords": [],
  "main": "dist/widgets.js",
  "umd:main": "dist/widgets.umd.js",
  "module": "dist/widgets.m.js",
  "typings": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "author": "Olivier Lance <olivier.lance@getalma.eu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alma/widgets.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=6.0.0"
  },
  "scripts": {
    "test": "vitest run --project unit --coverage",
    "test:no-coverage": "vitest run --project unit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts ./src/ && stylelint 'src/**/*.css'",
    "lint:fix": "eslint --fix --ext .ts ./src/ && stylelint 'src/**/*.css' --fix",
    "translations:extract": "echo 'translations:extract is disabled until the Lit message descriptors exist, because it would empty src/intl/messages.json.' >&2 && exit 1",
    "translations:upload": "crowdin upload sources",
    "translations:download": "crowdin download && prettier ./src/intl --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@crowdin/cli": "^4.3.0",
    "@formatjs/cli": "^6.3.5",
    "@octokit/core": "^6.1.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/clean-css": "^4.2.11",
    "@types/no-scroll": "^2.1.2",
    "@types/node": "^22.8.4",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitest/coverage-v8": "^5.0.3",
    "clean-css": "^5.3.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "expect-type": "^1.1.0",
    "husky": "^9.1.6",
    "jsdom": "^30.1.2",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "stylelint": "^13.13.1",
    "stylelint-a11y": "^1.2.3",
    "stylelint-config-standard": "^22.0.0",
    "ts-essentials": "^10.0.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "no-scroll": "^2.1.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.css": [
      "stylelint --fix"
    ],
    "{tests,scripts}/**/*.{ts,mjs}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "publishConfig": {
    "access": "public"
  }
}
